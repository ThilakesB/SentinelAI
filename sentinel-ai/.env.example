# SentinelAI Environment Variables
# Copy this to .env and fill in your values.

# ── Application ─────────────────────────────────────────────
APP_ENV=development                    # development | production
APP_SECRET_KEY=CHANGE_ME_USE_RANDOM_32_BYTES
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_USE_RANDOM_64_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database (Supabase PostgreSQL) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=10

# ── Local SQLite (threat-intel cache + offline) ─────────────
LOCAL_DB_PATH=./data/sentinel_local.db

# ── Threat Intelligence APIs ────────────────────────────────
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_KEY
ABUSEIPDB_CONFIDENCE_THRESHOLD=75     # 0-100; above this = suspicious
MALWAREBAZAAR_API_KEY=YOUR_BAZAAR_KEY
NVD_API_KEY=YOUR_NVD_KEY              # Free from nvd.nist.gov

# Optional (fallback only — strict TOS, use sparingly)
VIRUSTOTAL_API_KEY=

# ── Threat Intel Refresh ────────────────────────────────────
THREAT_INTEL_REFRESH_HOURS=6
MALWAREBAZAAR_SYNC_HOUR=3             # Daily sync at 3 AM
NVD_SYNC_HOUR=4

# ── YARA Rules ──────────────────────────────────────────────
YARA_RULES_DIR=./rules                # Place .yar files here

# ── ML Model ────────────────────────────────────────────────
ML_MODELS_DIR=./models
ML_RETRAIN_HOUR=3                     # Daily retrain at 3 AM
ML_ANOMALY_SUSPICIOUS_THRESHOLD=-0.1
ML_ANOMALY_CRITICAL_THRESHOLD=-0.3

# ── Monitoring ──────────────────────────────────────────────
MONITORING_INTERVAL_SEC=5
RESOURCE_BASELINE_WINDOW_MIN=60

# ── Response Engine ─────────────────────────────────────────
AUTO_KILL_CRITICAL=false              # Must be explicitly enabled
AUTO_BLOCK_IP_CRITICAL=true
